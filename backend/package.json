{
  "name": "marbletime-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MarbleTime API (one Lambda behind API Gateway, DynamoDB) and the CDK app that deploys it. Contract: openapi.yaml.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/dev-server.ts",
    "test": "tsc && vitest run",
    "test:dynamo": "DYNAMODB_ENDPOINT=${DYNAMODB_ENDPOINT:-http://localhost:8000} vitest run",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "2.1144.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
