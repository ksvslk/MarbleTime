{
  "name": "marbletime-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MarbleTime API (one Lambda behind API Gateway, DynamoDB) and the CDK app that deploys it. Contract: openapi.yaml.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/dev-server.ts",
    "test": "tsc && vitest run",
    "test:dynamo": "DYNAMODB_ENDPOINT=${DYNAMODB_ENDPOINT:-http://localhost:8000} vitest run",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy --context stage=dev --context signUp=closed --require-approval never"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.2",
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1146.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@napi-rs/canvas": "^1.0.10",
    "aws-cdk-lib": "^2.272.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.8.1",
    "saxes": "^6.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "aws-cdk": "2.1144.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
