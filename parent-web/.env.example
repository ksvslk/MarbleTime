# Settings for a real build (`npm run build`). Copy to .env.production.local (git-ignored) or set them in the
# shell, or skip them and let the host serve /config.json with the same values (see README).
# None of these are secrets: the app client is public (PKCE, no client secret).
VITE_AUTH=cognito
VITE_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
VITE_COGNITO_CLIENT_ID=exampleclientid
VITE_COGNITO_DOMAIN=https://marbletime-example.auth.us-east-1.amazoncognito.com
